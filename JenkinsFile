pipeline {
  agent none // Define agent as none at the top level
  stages {
    stage('Build') {
      agent {
        docker{
          image 'node:18-alpine'
          reuseNode true
        }
      } // Define agent for this stage
      steps {

        sh ''' 
        
        ls -la
        node --version
        npm --version
        echo "Hello there!!!"
        '''
      }
    }

  }
}