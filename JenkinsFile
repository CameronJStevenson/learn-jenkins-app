pipeline {
  agent none // Define agent as none at the top level
  stages {
    stage('Build') {
      agent {
        docker{
          image 'node:18-alpine'
          reuseNode true
        }
      } // Define agent for this stage
      //Adding an extra comment to update.
      steps {

        sh ''' 
        
        ls -la
        node --version
        npm --version
        npm ci
        ls -la
        echo "Build stage complete"
     
        '''
      }
    }
    stage ('Test'){
      sh '''
      echo "Completed test stage"
      '''
    }

  }
}